# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
server/build/
apps/web/dist/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/bundle-resources/
apps/web/node_modules/.vite/
apps/web/node_modules/.tmp/

# Local build cache markers (regenerated by scripts/assets-cache.sh)
**/.pixelanea-assets-hash

# Local tooling
.venv-build/
.venv-graphify/
.cache/deps/
.cache/assets/

# graphify knowledge graph (regenerate: ./scripts/setup-agent-tools.sh or ./scripts/graphify-update.sh)
graphify-out/

# Local Cursor usage logs (machine-specific, not product config)
.cursor/cursor-cost-log.json
.cursor/cursor-cost-log.md
.cursor/cursor-prompts-log.json
.cursor/cursor-prompts-log.md

# Environment
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo

# Generated skill run artifacts (reproducible locally)
.cursor/skill-outputs/

# Playwright
test-results/
playwright-report/

# README demo recordings (regenerate: ./scripts/record-linkedin-media.sh)
docs/media/linkedin/*.mp4
docs/media/linkedin/*.webm
docs/media/linkedin/fixtures/
