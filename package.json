{
  "name": "pixelanea",
  "version": "1.7.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:web": "./scripts/dev.sh --frontend-only",
    "dev:api": "./scripts/dev.sh --backend-only",
    "build": "pnpm -r build",
    "build:backend": "./scripts/dev.sh --build-only",
    "build:server": "pnpm build:backend",
    "build:desktop": "./scripts/build-desktop.sh",
    "build:desktop-shell": "./scripts/build-desktop-shell.sh",
    "desktop": "./scripts/run-desktop.sh",
    "desktop:shell": "./scripts/run-desktop-shell.sh",
    "install:desktop": "./scripts/install-desktop-linux.sh",
    "package:deb": "./scripts/package-deb.sh",
    "package:desktop": "./scripts/package-desktop-linux.sh",
    "test:package:linux": "./scripts/test-package-linux.sh",
    "test:desktop-shell": "./scripts/test-desktop-shell.sh",
    "lint": "pnpm lint:web && pnpm lint:cpp && pnpm lint:project",
    "lint:web": "pnpm --filter @pixelanea/web lint",
    "lint:cpp": "./scripts/lint-cpp.sh",
    "lint:project": "./scripts/lint-project.sh",
    "typecheck": "pnpm --filter @pixelanea/web exec tsc -b --noEmit",
    "test:unit": "pnpm --filter @pixelanea/web test",
    "test:unit:watch": "pnpm --filter @pixelanea/web test:watch",
    "test:qa": "pnpm --filter @pixelanea/web exec vitest run src/qa/",
    "test:e2e": "./scripts/e2e-playwright.sh",
    "test:e2e:install": "./scripts/e2e-install.sh",
    "test:smoke:backend": "./scripts/test-backend.sh",
    "test:smoke:frontend": "./scripts/test-frontend.sh",
    "test:smoke": "pnpm test:smoke:backend && pnpm test:smoke:frontend",
    "test:backend": "pnpm test:smoke:backend",
    "test:frontend": "pnpm test:smoke:frontend",
    "test": "pnpm test:smoke",
    "ci": "./scripts/ci.sh",
    "ci:fast": "./scripts/ci.sh fast",
    "ci:core": "./scripts/ci.sh core",
    "ci:e2e": "./scripts/ci.sh e2e",
    "ci:sprint": "./scripts/ci.sh sprint",
    "prepare": "node scripts/prepare.js",
    "hooks:install": "./scripts/install-git-hooks.sh",
    "generate:api": "pnpm --filter @pixelanea/api-client generate",
    "deps:hash": "python3 scripts/deps-hash.py",
    "deps:install": "./scripts/deps-cache.sh install",
    "deps:status": "./scripts/deps-cache.sh status",
    "assets:hash": "python3 scripts/assets-hash.py",
    "assets:build": "./scripts/assets-cache.sh ensure-all",
    "assets:status": "./scripts/assets-cache.sh status",
    "agent-tools:setup": "./scripts/setup-agent-tools.sh",
    "graphify:update": "./scripts/graphify-update.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  }
}
