#!/usr/bin/env bash
# Pre-commit gate — fast static checks only (tests/builds run on pre-push).
#
# Profiles:
#   hook-commit (default) — lint + typecheck
#   fast                  — + QA matrix + unit tests (legacy / PRE_COMMIT_CI=fast)
#
# Examples:
#   git commit -m "..."                         # hook-commit
#   PRE_COMMIT_CI=fast git commit -m "..."      # stricter
#   SKIP_PRE_COMMIT=1 git commit -m "..."       # skip hook
#   git commit --no-verify -m "..."             # skip hook
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PROFILE="${PRE_COMMIT_CI:-hook-commit}"

if [[ "${SKIP_PRE_COMMIT:-}" == "1" ]]; then
  echo "pre-commit: skipped (SKIP_PRE_COMMIT=1)"
  exit 0
fi

cd "${ROOT_DIR}"
echo "pre-commit: verifying VERSION manifests..."
"${ROOT_DIR}/scripts/verify-version.sh"

echo "pre-commit: running CI profile '${PROFILE}'..."
exec "${ROOT_DIR}/scripts/ci.sh" "${PROFILE}"
