#!/usr/bin/env bash
# Run the full CI workflow before each commit (mirrors .github/workflows/build.yml).
#
# Skip when needed:
#   SKIP_PRE_COMMIT=1 git commit ...
#   git commit --no-verify
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if [[ "${SKIP_PRE_COMMIT:-}" == "1" ]]; then
  echo "pre-commit: skipped (SKIP_PRE_COMMIT=1)"
  exit 0
fi

cd "${ROOT_DIR}"
echo "pre-commit: verifying VERSION manifests..."
"${ROOT_DIR}/scripts/verify-version.sh"

echo "pre-commit: running full CI (./scripts/ci.sh full)..."
exec "${ROOT_DIR}/scripts/ci.sh" full
