#!/usr/bin/env bash
# Pre-push gate — tests + builds (lint/typecheck run on pre-commit only).
#
# Profiles:
#   hook-push (default) — verify, deps, QA, unit, web/server build, backend tests
#   core                — hook-push + lint + typecheck (legacy / PRE_PUSH_CI=core)
#   full                — core + smoke scripts
#
# Examples:
#   git push                                      # hook-push
#   PRE_PUSH_CI=core git push                     # stricter (re-runs lint/typecheck)
#   SKIP_PRE_PUSH=1 git push                      # skip hook
#   git push --no-verify                          # skip hook
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PROFILE="${PRE_PUSH_CI:-hook-push}"

if [[ "${SKIP_PRE_PUSH:-}" == "1" ]]; then
  echo "pre-push: skipped (SKIP_PRE_PUSH=1)"
  exit 0
fi

cd "${ROOT_DIR}"
echo "pre-push: running CI profile '${PROFILE}'..."
exec "${ROOT_DIR}/scripts/ci.sh" "${PROFILE}"
