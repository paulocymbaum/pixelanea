#!/usr/bin/env bash
# Pre-push gate — runs before git push (not on commit).
#
# Profiles:
#   core (default) — builds + backend unit tests (matches pre-push safety net)
#   full           — core + smoke scripts
#
# Examples:
#   git push                                      # runs core
#   PRE_PUSH_CI=full git push                     # stricter
#   SKIP_PRE_PUSH=1 git push                      # skip hook
#   git push --no-verify                          # skip hook
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PROFILE="${PRE_PUSH_CI:-core}"

if [[ "${SKIP_PRE_PUSH:-}" == "1" ]]; then
  echo "pre-push: skipped (SKIP_PRE_PUSH=1)"
  exit 0
fi

cd "${ROOT_DIR}"
echo "pre-push: running CI profile '${PROFILE}'..."
exec "${ROOT_DIR}/scripts/ci.sh" "${PROFILE}"
